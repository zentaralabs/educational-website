# Copy to .env.local and fill in once the Supabase project exists.
# Project Settings > API in the Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, never expose to the browser.
# Used by src/lib/supabase/admin.ts and the ISR revalidation webhook route.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret checked against the Supabase webhook request to the
# revalidation route (src/app/api/revalidate/route.ts).
REVALIDATE_WEBHOOK_SECRET=

# Direct Postgres connection string (Supabase > Project Settings > Database).
# Used by the one-off data scripts in scripts/ and run_migration.mjs.
DATABASE_URL=

# Canonical public site URL — used for every canonical tag, OG tag, and the
# sitemap (src/lib/site-config.ts). Falls back to https://www.wheretoapply.xyz.
# Set this in the deploy environment (Vercel) to the real domain.
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). When set, the
# Analytics component (src/components/site/Analytics.tsx) loads GA4 — but
# only after the visitor accepts the cookie consent banner. Leave blank to
# keep analytics fully inert.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
