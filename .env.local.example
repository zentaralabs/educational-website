# Copy to .env.local and fill in once the Supabase project exists.
# Project Settings > API in the Supabase dashboard.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, never expose to the browser.
# Used by src/lib/supabase/admin.ts and the ISR revalidation webhook route.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret checked against the Supabase webhook request to the
# revalidation route (src/app/api/revalidate/route.ts).
REVALIDATE_WEBHOOK_SECRET=
